object FBCreateTableForm: TFBCreateTableForm
  Left = 400
  Height = 560
  Top = 180
  Width = 780
  Caption = 'Assistente de Criação de Tabela - Firebird'
  ClientHeight = 560
  ClientWidth = 780
  Position = poScreenCenter
  LCLVersion = '2.2.0.0'
  OnCreate = FormCreate
  object PanelTop: TPanel
    Left = 0
    Height = 60
    Top = 0
    Width = 780
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 60
    ClientWidth = 780
    TabOrder = 0
    object LabelTableName: TLabel
      Left = 14
      Height = 15
      Top = 18
      Width = 90
      Caption = 'Nome da Tabela:'
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object EditTableName: TEdit
      Left = 112
      Height = 23
      Top = 15
      Width = 240
      OnChange = EditTableNameChange
      TabOrder = 0
      Text = 'NOVA_TABELA'
    end
    object ChkFB3Identity: TCheckBox
      Left = 380
      Height = 19
      Top = 18
      Width = 220
      Caption = 'Firebird 3.0+ (Suporte a IDENTITY)'
      Checked = True
      OnChange = ChkFB3IdentityChange
      State = cbChecked
      TabOrder = 1
    end
    object BtnTemplateAudit: TButton
      Left = 615
      Height = 25
      Top = 14
      Width = 150
      Caption = '+ Colunas Padrão'
      OnClick = BtnTemplateAuditClick
      TabOrder = 2
    end
  end
  object PageControlMain: TPageControl
    Left = 0
    Height = 445
    Top = 60
    Width = 780
    ActivePage = TabSheetColumns
    Align = alClient
    TabIndex = 0
    TabOrder = 1
    object TabSheetColumns: TTabSheet
      Caption = 'Colunas / Campos'
      ClientHeight = 417
      ClientWidth = 772
      object PanelGridTools: TPanel
        Left = 0
        Height = 40
        Top = 0
        Width = 772
        Align = alTop
        BevelOuter = bvNone
        ClientHeight = 40
        ClientWidth = 772
        TabOrder = 0
        object BtnAddCol: TButton
          Left = 8
          Height = 28
          Top = 6
          Width = 120
          Caption = '+ Adicionar Campo'
          OnClick = BtnAddColClick
          TabOrder = 0
        end
        object BtnDelCol: TButton
          Left = 136
          Height = 28
          Top = 6
          Width = 110
          Caption = '- Remover'
          OnClick = BtnDelColClick
          TabOrder = 1
        end
        object BtnMoveUp: TButton
          Left = 254
          Height = 28
          Top = 6
          Width = 80
          Caption = '▲ Subir'
          OnClick = BtnMoveUpClick
          TabOrder = 2
        end
        object BtnMoveDown: TButton
          Left = 342
          Height = 28
          Top = 6
          Width = 80
          Caption = '▼ Descer'
          OnClick = BtnMoveDownClick
          TabOrder = 3
        end
      end
      object GridColumns: TStringGrid
        Left = 0
        Height = 377
        Top = 40
        Width = 772
        Align = alClient
        ColCount = 8
        DefaultRowHeight = 24
        FixedCols = 0
        Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRangeSelect, goEditing, goAlwaysShowEditor, goSmoothScroll]
        RowCount = 2
        TabOrder = 1
        OnEditingDone = GridColumnsEditingDone
      end
    end
    object TabSheetPreview: TTabSheet
      Caption = 'Script SQL Gerado'
      ClientHeight = 417
      ClientWidth = 772
      object MemoSQLPreview: TMemo
        Left = 0
        Height = 417
        Top = 0
        Width = 772
        Align = alClient
        Font.Name = 'Courier New'
        Font.Pitch = fpFixed
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
      end
    end
  end
  object PanelBottom: TPanel
    Left = 0
    Height = 55
    Top = 505
    Width = 780
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 55
    ClientWidth = 780
    TabOrder = 2
    object BtnExecute: TButton
      Left = 14
      Height = 35
      Top = 10
      Width = 160
      Caption = '🚀 Criar Tabela no Banco'
      Default = True
      Font.Style = [fsBold]
      OnClick = BtnExecuteClick
      ParentFont = False
      TabOrder = 0
    end
    object BtnCopySQL: TButton
      Left = 184
      Height = 35
      Top = 10
      Width = 110
      Caption = 'Copiar SQL'
      OnClick = BtnCopySQLClick
      TabOrder = 1
    end
    object BtnClose: TButton
      Left = 670
      Height = 35
      Top = 10
      Width = 95
      Cancel = True
      Caption = 'Fechar'
      ModalResult = 11
      TabOrder = 2
    end
  end
end
