object FBConnectionDialog: TFBConnectionDialog
  Left = 450
  Height = 440
  Top = 220
  Width = 500
  BorderStyle = bsDialog
  Caption = 'Conectar ao Firebird'
  ClientHeight = 440
  ClientWidth = 500
  Position = poScreenCenter
  LCLVersion = '2.2.0.0'
  OnCreate = FormCreate
  OnShow = FormShow
  object GroupBoxProfile: TGroupBox
    Left = 16
    Height = 65
    Top = 10
    Width = 468
    Caption = 'Perfil de Conexão'
    ClientHeight = 45
    ClientWidth = 464
    TabOrder = 0
    object LabelProfile: TLabel
      Left = 12
      Height = 15
      Top = 14
      Width = 33
      Caption = 'Perfil:'
      ParentColor = False
    end
    object ComboProfiles: TComboBox
      Left = 56
      Height = 23
      Top = 10
      Width = 230
      ItemHeight = 15
      OnChange = ComboProfilesChange
      Style = csDropDownList
      TabOrder = 0
    end
    object BtnSaveProfile: TButton
      Left = 296
      Height = 25
      Top = 9
      Width = 75
      Caption = 'Salvar'
      OnClick = BtnSaveProfileClick
      TabOrder = 1
    end
    object BtnDeleteProfile: TButton
      Left = 378
      Height = 25
      Top = 9
      Width = 75
      Caption = 'Excluir'
      OnClick = BtnDeleteProfileClick
      TabOrder = 2
    end
  end
  object GroupBoxParams: TGroupBox
    Left = 16
    Height = 295
    Top = 85
    Width = 468
    Caption = 'Parâmetros do Banco de Dados'
    ClientHeight = 275
    ClientWidth = 464
    TabOrder = 1
    object LabelName: TLabel
      Left = 12
      Height = 15
      Top = 12
      Width = 83
      Caption = 'Nome do Perfil:'
      ParentColor = False
    end
    object EditProfileName: TEdit
      Left = 120
      Height = 23
      Top = 8
      Width = 330
      TabOrder = 0
      Text = 'Novo Perfil'
    end
    object LabelHost: TLabel
      Left = 12
      Height = 15
      Top = 44
      Width = 72
      Caption = 'Servidor/Host:'
      ParentColor = False
    end
    object EditHost: TEdit
      Left = 120
      Height = 23
      Top = 40
      Width = 200
      TabOrder = 1
      Text = 'localhost'
    end
    object LabelPort: TLabel
      Left = 332
      Height = 15
      Top = 44
      Width = 31
      Caption = 'Porta:'
      ParentColor = False
    end
    object EditPort: TEdit
      Left = 372
      Height = 23
      Top = 40
      Width = 78
      TabOrder = 2
      Text = '3050'
    end
    object LabelDatabase: TLabel
      Left = 12
      Height = 15
      Top = 76
      Width = 92
      Caption = 'Caminho do FDB:'
      ParentColor = False
    end
    object EditDatabase: TEdit
      Left = 120
      Height = 23
      Top = 72
      Width = 295
      TabOrder = 3
    end
    object BtnBrowseDB: TButton
      Left = 420
      Height = 23
      Top = 72
      Width = 30
      Caption = '...'
      OnClick = BtnBrowseDBClick
      TabOrder = 4
    end
    object LabelUser: TLabel
      Left = 12
      Height = 15
      Top = 108
      Width = 43
      Caption = 'Usuário:'
      ParentColor = False
    end
    object EditUser: TEdit
      Left = 120
      Height = 23
      Top = 104
      Width = 140
      TabOrder = 5
      Text = 'SYSDBA'
    end
    object LabelPassword: TLabel
      Left = 12
      Height = 15
      Top = 140
      Width = 35
      Caption = 'Senha:'
      ParentColor = False
    end
    object EditPassword: TEdit
      Left = 120
      Height = 23
      Top = 136
      Width = 140
      EchoMode = emPassword
      PasswordChar = '*'
      TabOrder = 6
      Text = 'masterkey'
    end
    object LabelCharset: TLabel
      Left = 12
      Height = 15
      Top = 172
      Width = 43
      Caption = 'Charset:'
      ParentColor = False
    end
    object ComboCharset: TComboBox
      Left = 120
      Height = 23
      Top = 168
      Width = 140
      ItemHeight = 15
      ItemIndex = 0
      Items.Strings = (
        'UTF8'
        'WIN1252'
        'ISO8859_1'
        'NONE'
      )
      Style = csDropDownList
      TabOrder = 7
      Text = 'UTF8'
    end
    object LabelClientLib: TLabel
      Left = 12
      Height = 15
      Top = 204
      Width = 84
      Caption = 'fbclient.dll (opc):'
      ParentColor = False
    end
    object EditClientLib: TEdit
      Left = 120
      Height = 23
      Top = 200
      Width = 295
      TabOrder = 8
    end
    object BtnBrowseClient: TButton
      Left = 420
      Height = 23
      Top = 200
      Width = 30
