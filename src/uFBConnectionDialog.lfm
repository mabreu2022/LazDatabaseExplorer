    end
    object BtnCreateNewDB: TButton
      Left = 275
      Height = 28
      Top = 236
      Width = 175
      Caption = 'Criar Novo Banco (.FDB)'
      OnClick = BtnCreateNewDBClick
      TabOrder = 11
    end
  end
  object BtnConnect: TButton
    Left = 288
    Height = 32
    Top = 392
    Width = 95
    Caption = 'Conectar'
    Default = True
    OnClick = BtnConnectClick
    TabOrder = 2
  end
  object BtnCancel: TButton
    Left = 390
    Height = 32
    Top = 392
    Width = 94
    Cancel = True
    Caption = 'Cancelar'
    ModalResult = 2
    TabOrder = 3
  end
  object OpenDialogDB: TOpenDialog
    DefaultExt = '.fdb'
    Filter = 'Bancos Firebird (*.fdb;*.gdb)|*.fdb;*.gdb|Todos os arquivos (*.*)|*.*'
    Left = 40
    Top = 390
  end
  object OpenDialogLib: TOpenDialog
    DefaultExt = '.dll'
    Filter = 'Bibliotecas Firebird (fbclient.dll;*.so)|fbclient.dll;*.so*|Todos os arquivos (*.*)|*.*'
    Left = 90
    Top = 390
  end
end
