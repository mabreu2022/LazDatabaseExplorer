      ParentColor = False
      ParentFont = False
    end
  end
  object MemoContent: TMemo
    Left = 0
    Height = 372
    Top = 56
    Width = 600
    Align = alClient
    Font.Name = 'Courier New'
    Font.Size = 10
    OnChange = MemoContentChange
    ParentFont = False
