    ClientWidth = 600
    Color = 15724527
    ParentColor = False
    TabOrder = 0
    object LabelFieldName: TLabel
      Left = 14
      Height = 17
      Top = 10
      Width = 120
      Caption = 'Campo: NOME'
      Font.Height = -13
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object LabelFieldType: TLabel
      Left = 14
      Height = 15
      Top = 32
      Width = 100
      Caption = 'Tipo: ftString'
      Font.Color = clGray
      ParentColor = False
      ParentFont = False
