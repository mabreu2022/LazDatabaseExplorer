  ClientWidth = 600
  Position = poScreenCenter
  LCLVersion = '2.2.0.0'
  OnCreate = FormCreate
  object PanelTop: TPanel
    Left = 0
    Height = 56
    Top = 0
    Width = 600
    Align = alTop
